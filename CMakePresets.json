{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC x64 (Release, vcpkg) — core + POE2 + FOX + D4",
      "description": "POE2_SRC / FOX_SRC / D4_SRC point at the sibling project folders (G:\\G Claude Projects\\AssetBrowser since 2026-10-05). Buildtrees go to %USERPROFILE%/vbt (short + writable: vcpkg paths hit MAX_PATH).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_OBJECT_PATH_MAX": "240",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=$env{USERPROFILE}/vbt",
        "POE2_SRC": "${sourceDir}/../POE2AssetBrowser",
        "FOX_SRC": "${sourceDir}/../FOXAssetBrowser",
        "D4_SRC": "${sourceDir}/../Diablo4AssetBrowser Native",
        "ASSETBROWSER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "windows-msvc-release",
      "displayName": "Windows MSVC x64 (Debug, vcpkg)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "windows-msvc-release" },
    { "name": "debug",   "configurePreset": "windows-msvc-debug" }
  ]
}
